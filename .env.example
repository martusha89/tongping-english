# TongPing Personal Edition configuration template
# Copy this file to .env beside package.json, then adjust as needed.
# One KEY=VALUE per line; # starts a comment. Restart npm run up after changes.
# Variables already set in the command-line environment take precedence over .env.

# ---------- Basics (most users only need this section) ----------

# Use the Chrome already installed on this computer (recommended). For Edge, use msedge.
# Remove this line to use Chromium downloaded with `npx playwright install chromium`.
TONGPING_CHANNEL=chrome

# Data directory: login sessions, cookies, tokens, and chat history. Do not put it in the repository or share it.
# Defaults to .tongping in your home directory.
# TONGPING_HOME=~/.tongping

# Port. If in use, choose another, such as 46921.
# TONGPING_PORT=45921

# Browser interface language and time zone (optional)
# TONGPING_LOCALE=en-US
# TONGPING_TIMEZONE=Europe/London

# 1 = no browser window (servers / no desktop). On desktops, keep the default: Watch Together recording and manual login takeover are untested in headless mode.
# TONGPING_HEADLESS=1

# ---------- Connect claude.ai / ChatGPT web (requires a public HTTPS tunnel) ----------
# Leave this section blank if you only use local Claude Code / Codex.

# Tunnel HTTPS origin: domain only, no /mcp and no trailing slash.
# TONGPING_PUBLIC_ORIGIN=https://xxxx-xxxx.trycloudflare.com

# Authorization password: Claude / ChatGPT opens a page asking for it on first connection.
# The page is publicly reachable. Use a random string of at least 12 characters, unique to this service.
# TONGPING_OAUTH_PASSWORD=

# Usually unnecessary: the launcher automatically allowlists the TONGPING_PUBLIC_ORIGIN domain.
# Set manually only for multiple domains (comma-separated; include localhost,127.0.0.1,[::1]).
# TONGPING_ALLOWED_HOSTS=
# TONGPING_ALLOWED_ORIGINS=

# ---------- Optional features ----------

# “Hold to talk” speech-to-text in the card (SiliconFlow SenseVoice). Disabled without a key.
# Alternatively, store the key in <TONGPING_HOME>/daemon/siliconflow.key.
# TONGPING_SILICONFLOW_KEY=

# Local subtitles (enabled automatically after npm run asr:install; all settings below are optional)
# Model download mirror for mainland China (npm run asr:install -- --cn writes this automatically)
# HF_ENDPOINT=https://hf-mirror.com
# auto (GPU if NVIDIA is available) | cuda | cpu
# TONGPING_ASR_DEVICE=auto
# GPU model / CPU model
# TONGPING_ASR_MODEL=large-v3-turbo
# TONGPING_ASR_CPU_MODEL=small
# Subtitle service installation directory; defaults to TONGPING_HOME/asr
# TONGPING_ASR_DIR=

# ---------- Advanced (leave unchanged unless you understand these settings) ----------
# TONGPING_HOST=127.0.0.1          # Local listening only. Do not set 0.0.0.0 and expose it to the LAN/internet.
# TONGPING_EXECUTABLE_PATH=        # Custom browser executable; takes precedence over TONGPING_CHANNEL
# TONGPING_WORKER_NAME=            # Worker name; defaults to the computer name
