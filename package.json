{
  "name": "tongping",
  "version": "0.4.0-personal.2",
  "private": true,
  "type": "module",
  "description": "TongPing Personal Edition: a shared browser for AI (web browsing, watching videos together, group chat), connecting Claude / ChatGPT through MCP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "node scripts/start.mjs",
    "selftest": "node scripts/selftest.mjs",
    "start": "tsx src/index.ts",
    "mcp": "tsx src/index.ts",
    "daemon": "tsx src/daemon.ts",
    "typecheck": "tsc --noEmit",
    "build:hosted": "esbuild src/hosted-main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/hosted.mjs",
    "build:local-app-host": "node scripts/build-local-app-host.mjs",
    "smoke:local-app": "node scripts/smoke-local-app.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build:local-app-host && npm run typecheck && npm test",
    "doctor": "node scripts/doctor.mjs",
    "asr:install": "node scripts/install-asr.mjs",
    "room:watch": "node scripts/room-watch.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "opusscript": "^0.1.1",
    "playwright": "^1.54.0",
    "ws": "^8.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
